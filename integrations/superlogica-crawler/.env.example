# Copie para .env nesta pasta.
# Nunca versionar valores reais.

# --- Superlógica (UI) ---
SUPERLOGICA_BASE_URL=https://apps.superlogica.net/imobiliaria
SUPERLOGICA_USER=
SUPERLOGICA_PASSWORD=

# Opcional: URL de entrada (ex. MFA challenge). Vazio = BASE_URL
SUPERLOGICA_START_URL=

# true = mostra o browser (útil no primeiro login / ajuste de seletores)
PLAYWRIGHT_HEADED=false

# --- Gmail (OTP MFA via browser) ---
GMAIL_URL=https://mail.google.com/mail/u/0/?ogbl#inbox
GMAIL_USER=
GMAIL_PASSWORD=

# --- MFA: e-mail alternativo (IMAP) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FROM_FILTER=superlogica
IMAP_SUBJECT_FILTER=
OTP_REGEX=(\\d{4,8})
OTP_VIA=auto
OTP_TIMEOUT_SEC=90
OTP_POLL_SEC=10

# --- Google Drive (opção 1: CSV → pasta → Sheets) ---
# Pasta: 196a-automacao-superlogica-controller
# Vazio = não envia (coloque o CSV na pasta à mão).
DRIVE_FOLDER_ID=
DRIVE_UPLOAD=true
# JSON da service account (caminho). Alternativa: GOOGLE_SERVICE_ACCOUNT_JSON com o JSON cru.
GOOGLE_APPLICATION_CREDENTIALS=.auth/google-sa.json
