# Copie para .env nesta pasta. Nunca versionar valores reais.
# Controlle usa UM único token (Bearer) — não é app_token/access_token da Superlógica.

CONTROLLE_API_TOKEN=
CONTROLLE_API_BASE=https://api-v1.controlle.com

# Preencha após: npm run resolve-ids
CONTROLLE_ID_CATEGORIA_3112=
CONTROLLE_ID_CENTRO_INTERMEDIACAO=
CONTROLLE_ID_CONTA_PADRAO=

# Opcional: path default do CSV local (output do crawler)
# CONTROLLE_CSV_PATH=../superlogica-crawler/output/arquivo.csv
